# OpenAI — sole LLM provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_FALLBACK_MODEL=gpt-5-mini

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=sentinel-password

# Embeddings (local, via sentence-transformers)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
DEPENDENCY_SIMILARITY_THRESHOLD=0.80

# Jira / Confluence (wired in Phase 9)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
CONFLUENCE_BASE_URL=
CONFLUENCE_SPACE_KEY=

# Langfuse (wired in Phase 10)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
